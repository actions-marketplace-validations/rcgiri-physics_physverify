{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.rcgiri-physics/physverify",
  "description": "Runs physverify verification specs (convergence order, conservation) on physics code. It runs the code it checks; use it on trusted code only.",
  "repository": {
    "url": "https://github.com/rcgiri-physics/physverify",
    "source": "github"
  },
  "version": "0.5.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "physverify",
      "version": "0.5.0",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ]
    }
  ]
}
